{
  "name": "@deepseek-ai/dsh-evolution-activity",
  "description": "Durable activity store for self-evolution plan outcomes",
  "version": "0.44.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/evolution/evolution-activity"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./feedback": {
      "types": "./lib/types/feedback/index.d.ts",
      "default": "./lib/feedback/index.js"
    },
    "./feedback/locale/*.json": "./locale/feedback/*.json",
    "./replay": {
      "types": "./lib/types/replay/index.d.ts",
      "default": "./lib/replay/index.js"
    },
    "./replay/locale/*.json": "./locale/replay/*.json",
    "./learning-graph": {
      "types": "./lib/types/learning-graph/index.d.ts",
      "default": "./lib/learning-graph/index.js"
    },
    "./learning-graph/locale/*.json": "./locale/learning-graph/*.json",
    "./threat": {
      "types": "./lib/types/threat/index.d.ts",
      "default": "./lib/threat/index.js"
    },
    "./threat/locale/*.json": "./locale/threat/*.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/*.js",
    "lib/types/**/*.d.ts",
    "locale/**/*.json",
    "locale/*.json"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-evolution-core": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "@deepseek-ai/dsh-evolution-skill-discovery": "workspace:^",
    "@deepseek-ai/dsh-evolution-approval": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-evolution-core": "workspace:^"
  }
}
