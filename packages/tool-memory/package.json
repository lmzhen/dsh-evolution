    "@deepseek-ai/dsh-system-prompt": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/dsh-memory": "workspace:^",
    "@deepseek-ai/dsh-memory-files": "workspace:^",
