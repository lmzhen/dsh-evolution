{
  "name": "@deepseek-ai/dsh-tool-memory",
  "description": "Model-facing memory tool and prompt context",
  "version": "0.1.0-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
