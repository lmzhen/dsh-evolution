{
  "name": "@deepseek-ai/dsh-evolution-preset",
  "description": "Compatibility one-click bundle for the dsh-evolution plugin family",
  "version": "0.1.0-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lmzhen/dsh-evolution.git",
    "directory": "packages/evolution/evolution-preset"
  },
  "type": "module",
  "main": "index.js",
  "files": [
    "cordis.yml",
    "cordis.patch.yml",
    "package.json"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
