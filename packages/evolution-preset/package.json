{
  "name": "@deepseek-ai/dsh-evolution-preset",
  "description": "Compatibility one-click bundle (legacy; new installs should use evolution-all)",
  "version": "0.44.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/evolution/evolution-preset"
  },
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "cordis.yml",
    "cordis.patch.yml",
    "package.json",
    "lib/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "//": "dependencies carries @deepseek-ai/dsh-evolution-maintenance because the one-click cordis.patch.yml mounts '@deepseek-ai/dsh-evolution-maintenance/tools'. The STANDALONE cordis.yml deliberately omits that row (see its header, H-01): a standalone compose must add the row itself, and the dependency exists so an added row resolves without editing dependencies again.",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "resolverDependencies": [
      "@deepseek-ai/dsh-evolution-core"
    ]
  },
  "dependencies": {
    "@deepseek-ai/dsh-evolution-state": "workspace:^",
    "@deepseek-ai/dsh-memory": "workspace:^",
    "@deepseek-ai/dsh-tool-skill-manage": "workspace:^",
    "@deepseek-ai/dsh-evolution-approval": "workspace:^",
    "@deepseek-ai/dsh-evolution-review": "workspace:^",
    "@deepseek-ai/dsh-evolution-curator": "workspace:^",
    "@deepseek-ai/dsh-evolution-commands": "workspace:^",
    "@deepseek-ai/dsh-evolution-merge": "workspace:^",
    "@deepseek-ai/dsh-evolution-maintenance": "workspace:^",
    "@deepseek-ai/dsh-evolution-activity": "workspace:^",
    "@deepseek-ai/dsh-evolution-core": "workspace:^",
    "@deepseek-ai/dsh-evolution-skill-discovery": "workspace:^",
    "@deepseek-ai/dsh-tool-session-query": "^0.2.2-rc.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-storage": "^0.2.2-rc.0",
    "@deepseek-ai/dsh-storage-json": "^0.2.2-rc.0",
    "@deepseek-ai/dsh-storage-domain": "^0.2.2-rc.0"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.yml": "./cordis.yml",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "types": "lib/types/index.d.ts"
}
