{
  "name": "@deepseek-ai/dsh-evolution-preset",
  "description": "Compatibility one-click bundle for the dsh-evolution plugin family",
  "version": "0.3.19",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/evolution/evolution-preset"
  },
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "cordis.yml",
    "cordis.patch.yml",
    "package.json",
    "lib/invariant.js",
    "lib/types/invariant.d.ts",
    "lib/index.js",
    "lib/types/index.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-evolution-io": "workspace:^",
    "@deepseek-ai/dsh-evolution-io-node": "workspace:^",
    "@deepseek-ai/dsh-storage": "workspace:^",
    "@deepseek-ai/dsh-storage-json": "workspace:^",
    "@deepseek-ai/dsh-storage-domain": "workspace:^",
    "@deepseek-ai/dsh-evolution-state-storage": "workspace:^",
    "@deepseek-ai/dsh-evolution-state": "workspace:^",
    "@deepseek-ai/dsh-evolution-state-domain": "workspace:^",
    "@deepseek-ai/dsh-evolution-state-json": "workspace:^",
    "@deepseek-ai/dsh-memory": "workspace:^",
    "@deepseek-ai/dsh-memory-files": "workspace:^",
    "@deepseek-ai/dsh-tool-memory": "workspace:^",
    "@deepseek-ai/dsh-skill-usage": "workspace:^",
    "@deepseek-ai/dsh-tool-skill-manage": "workspace:^",
    "@deepseek-ai/dsh-tool-session-query": "workspace:^",
    "@deepseek-ai/dsh-evolution-policy": "workspace:^",
    "@deepseek-ai/dsh-evolution-approval": "workspace:^",
    "@deepseek-ai/dsh-evolution-threat": "workspace:^",
    "@deepseek-ai/dsh-evolution-review": "workspace:^",
    "@deepseek-ai/dsh-evolution-curator": "workspace:^",
    "@deepseek-ai/dsh-evolution-commands": "workspace:^",
    "@deepseek-ai/dsh-evolution-maintenance": "workspace:^",
    "@deepseek-ai/dsh-evolution-activity": "workspace:^",
    "@deepseek-ai/dsh-evolution-feedback": "workspace:^",
    "@deepseek-ai/dsh-evolution-learning-graph": "workspace:^",
    "@deepseek-ai/dsh-evolution-replay": "workspace:^",
    "@deepseek-ai/dsh-evolution-skill-catalog": "workspace:^"
  },
  "exports": {
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.yml": "./cordis.yml",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "types": "lib/types/index.d.ts"
}
