{
  "name": "@deepseek-ai/dsh-evolution-state",
  "description": "Durable evolution state consumer over pluggable storage providers",
  "version": "0.46.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/evolution/evolution-state"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./storage": {
      "types": "./lib/types/storage.d.ts",
      "default": "./lib/storage.js"
    },
    "./domain": {
      "types": "./lib/types/domain/index.d.ts",
      "default": "./lib/domain/index.js"
    },
    "./domain/locale/*.json": "./locale/domain/*.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/*.js",
    "lib/types/**/*.d.ts",
    "locale/**/*.json",
    "locale/*.json"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^",
    "@deepseek-ai/dsh-evolution-core": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {}
}
