{
  "name": "@deepseek-ai/dsh-evolution-platform",
  "description": "The platform adapter and generated-contract surface for the dsh-evolution family",
  "version": "0.61.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/evolution-platform"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./service": {
      "types": "./lib/types/service.d.ts",
      "default": "./lib/service.js"
    },
    "./ports": {
      "types": "./lib/types/ports.d.ts",
      "default": "./lib/ports.js"
    },
    "./values": {
      "types": "./lib/types/values.d.ts",
      "default": "./lib/values.js"
    },
    "./review-child": {
      "types": "./lib/types/review-child.d.ts",
      "default": "./lib/review-child.js"
    },
    "./package.json": "./package.json",
    "./contract": {
      "types": "./lib/types/contract/index.d.ts",
      "default": "./lib/contract/index.js"
    },
    "./contract/result": {
      "types": "./lib/types/contract/result.d.ts",
      "default": "./lib/contract/result.js"
    },
    "./values/fs": {
      "types": "./lib/types/values-fs.d.ts",
      "default": "./lib/values-fs.js"
    },
    "./values/scope": {
      "types": "./lib/types/values-scope.d.ts",
      "default": "./lib/values-scope.js"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "locale/*.json"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-atomic-write": "workspace:^",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-agent": "workspace:^",
    "@deepseek-ai/dsh-commands": "workspace:^",
    "@deepseek-ai/dsh-llm": "workspace:^",
    "@deepseek-ai/dsh-scope": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
    "@deepseek-ai/dsh-skill": "workspace:^",
    "@deepseek-ai/dsh-storage-domain": "workspace:^",
    "@deepseek-ai/dsh-subagent": "workspace:^",
    "@deepseek-ai/dsh-system-prompt": "workspace:^",
    "@deepseek-ai/dsh-tools": "workspace:^",
    "@deepseek-ai/dsh-working-directory": "workspace:^"
  }
}
