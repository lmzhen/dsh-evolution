{
  "schemaVersion": 1,
  "modelsRoot": "models",
  "recipes": {
    "fp16-cast": {
      "builderVer": 1,
      "description": "把 FP32 静态表分块转为 FP16（每块 40000 行），更新 config.embedding_dtype=float16",
      "params": {
        "sourceDtype": "F32",
        "targetDtype": "F16",
        "step": 40000,
        "configPatch": {
          "embedding_dtype": "float16"
        }
      }
    },
    "int8-per-row": {
      "builderVer": 1,
      "description": "逐行对称 int8 量化：scale=max_abs(row)/127（0→1e-8），q=clip(round_half_even(x/scale),-127,127)",
      "params": {
        "dtype": "I8",
        "scalesFile": "scales.f32",
        "scalesDtype": "F32",
        "maxQ": 127,
        "minQ": -127,
        "scaleFormula": "max_abs/127",
        "zeroScale": 1e-8,
        "rounding": "half-even",
        "configPatch": {
          "embedding_dtype": "int8",
          "quantization": "per_row_symmetric",
          "scales_file": "scales.f32",
          "source_model": "potion-multilingual-128M-F16"
        }
      }
    },
    "pca-project-int8": {
      "builderVer": 1,
      "description": "PCA 投影到 64 维后逐行 int8：采样 step=rows//50000，cov=X^T X(double)，eigh 取 top64，proj=x@U，再 int8-per-row",
      "params": {
        "dims": 64,
        "sampleStepFormula": "rows//50000",
        "covariance": "double",
        "eigen": "eigh",
        "quantize": "int8-per-row",
        "scalesFile": "scales.f32",
        "configPatch": {
          "hidden_dim": 64,
          "embedding_dtype": "int8",
          "quantization": "per_row_symmetric",
          "scales_file": "scales.f32",
          "pca_proj_file": "pca_proj.f32",
          "pca_dims": 64,
          "orig_hidden_dim": 256,
          "source_model": "potion-multilingual-128M-F16",
          "pca_fit": "50k evenly-spaced rows, torch covariance"
        }
      }
    }
  },
