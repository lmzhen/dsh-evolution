{
  "name": "skill-merge-pipeline",
  "version": "1.0.0",
  "type": "module",
  "description": "Node 版 skill 合并流水线：①预过滤→②LSH候选→③词面→④向量→④.5精排→⑤三级判决；零运行时依赖、可复现、与 Python oracle 同口径",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./merge": "./src/merge/index.js",
    "./pipeline": "./src/pipeline/index.js",
    "./cli": "./src/cli.js",
    "./screening": "./src/screening/index.js",
    "./contracts": "./src/contracts.js",
    "./contracts/report": "./src/contracts/report.js",
    "./contracts/stage": "./src/contracts/stage.js",
    "./contracts/merge": "./src/contracts/merge.js"
  },
  "scripts": {
    "run": "node src/run.js",
    "doctor": "node tools/doctor.js",
    "test": "node --test \"test/*.test.js\" && node bench/run.js",
