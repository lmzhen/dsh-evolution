{
  "name": "@deepseek-ai/dsh-evolution-merge-engine",
  "description": "Vendored skill-merge Node pipeline engine (byte-identical upstream) for DSH evolution-merge",
  "version": "0.45.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/",
    "data/",
    "vendor/skill-merge-pipeline/models/registry.json",
    "vendor/skill-merge-pipeline/models/pca64/",
    "LICENSE",
    "NOTICE",
    "UPSTREAM.json"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test \"vendor/skill-merge-pipeline/test/*.test.js\"",
    "verify:upstream": "node verify-upstream.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:tarball": "node scripts/verify-tarball.mjs"
  },
  "license": "MIT"
}
