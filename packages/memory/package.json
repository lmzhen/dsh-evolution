{
  "name": "@deepseek-ai/dsh-memory",
  "description": "Memory provider registry for self-evolution",
  "version": "0.44.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/evolution/memory"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./files": {
      "types": "./lib/types/files/index.d.ts",
      "default": "./lib/files/index.js"
    },
    "./files/locale/*.json": "./locale/files/*.json",
    "./tools": {
      "types": "./lib/types/tools/index.d.ts",
      "default": "./lib/tools/index.js"
    },
    "./tools/locale/*.json": "./locale/tools/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^",
    "@deepseek-ai/dsh-evolution-core": "workspace:^",
    "@deepseek-ai/dsh-evolution-approval": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  }
}
