{
  "name": "@deepseek-ai/dsh-evolution-core",
  "description": "Shared stores, prompts, signals and lifecycle logic for the dsh-evolution plugin family",
  "version": "0.30.36",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/evolution/evolution-core"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./composition": {
      "types": "./lib/types/composition/index.d.ts",
      "default": "./lib/composition/index.js"
    },
    "./subagent": {
      "types": "./lib/types/subagent/index.d.ts",
      "default": "./lib/subagent/index.js"
    },
    "./http-routes": {
      "types": "./lib/types/http-routes.d.ts",
      "default": "./lib/http-routes.js"
    },
    "./restrictor": {
      "types": "./lib/types/restrictor.d.ts",
      "default": "./lib/restrictor.js"
    },
    "./package.json": "./package.json",
    "./row-overrides.json": "./row-overrides.json",
    "./persisted-write-inventory.json": "./persisted-write-inventory.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "row-overrides.json",
    "persisted-write-inventory.json"
  ],
  "license": "MIT",
  "dependencies": {
    "yaml": "^2.4.2",
    "zod": "^4.4.3",
    "js-yaml": "^4.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-scope": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
    "@deepseek-ai/dsh-session-projection": "workspace:^",
    "@deepseek-ai/dsh-agent": "workspace:^",
    "@deepseek-ai/dsh-subagent": "workspace:^",
    "@deepseek-ai/dsh-tools": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-scope": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
    "@deepseek-ai/dsh-session-projection": "workspace:^",
    "@deepseek-ai/dsh-agent": "workspace:^",
    "@deepseek-ai/dsh-subagent": "workspace:^",
    "@deepseek-ai/dsh-tools": "workspace:^",
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^4.1.0"
  }
}
