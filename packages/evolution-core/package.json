{
  "name": "@deepseek-ai/dsh-evolution-core",
  "description": "Shared stores, prompts, signals and lifecycle logic for the dsh-evolution plugin family",
  "version": "0.61.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/evolution/evolution-core"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./composition": {
      "types": "./lib/types/composition/index.d.ts",
      "default": "./lib/composition/index.js"
    },
    "./subagent": {
      "types": "./lib/types/subagent/index.d.ts",
      "default": "./lib/subagent/index.js"
    },
    "./http-routes": {
      "types": "./lib/types/http-routes.d.ts",
      "default": "./lib/http-routes.js"
    },
    "./runtime": {
      "types": "./lib/types/runtime/plugin.d.ts",
      "default": "./lib/runtime/plugin.js"
    },
    "./restrictor": {
      "types": "./lib/types/restrictor.d.ts",
      "default": "./lib/restrictor.js"
    },
    "./write": {
      "types": "./lib/types/write.d.ts",
      "default": "./lib/write.js"
    },
    "./skills": {
      "types": "./lib/types/skills.d.ts",
      "default": "./lib/skills.js"
    },
    "./package.json": "./package.json",
    "./row-overrides.json": "./row-overrides.json",
    "./persisted-write-inventory.json": "./persisted-write-inventory.json",
    "./locale/*.json": "./locale/*.json",
    "./runtime/locale/*.json": "./locale/runtime/*.json",
    "./contract": {
      "types": "./lib/types/contract.d.ts",
      "default": "./lib/contract.js"
    },
    "./result": {
      "types": "./lib/types/result.d.ts",
      "default": "./lib/result.js"
    },
    "./errors": {
      "types": "./lib/types/errors.d.ts",
      "default": "./lib/errors.js"
    },
    "./extract": {
      "types": "./lib/types/extract.d.ts",
      "default": "./lib/extract.js"
    },
    "./io-registry": {
      "types": "./lib/types/io-registry.d.ts",
      "default": "./lib/io-registry.js"
    },
    "./io-node": {
      "types": "./lib/types/io-node.d.ts",
      "default": "./lib/io-node.js"
    },
    "./io-platform": {
      "types": "./lib/types/io-platform.d.ts",
      "default": "./lib/io-platform.js"
    },
    "./authority-plugin": {
      "types": "./lib/types/authority-plugin.d.ts",
      "default": "./lib/authority-plugin.js"
    },
    "./policy": {
      "types": "./lib/types/policy.d.ts",
      "default": "./lib/policy.js"
    },
    "./state": {
      "types": "./lib/types/state/index.d.ts",
      "default": "./lib/state/index.js"
    },
    "./state/storage": {
      "types": "./lib/types/state/storage.d.ts",
      "default": "./lib/state/storage.js"
    },
    "./state/domain": {
      "types": "./lib/types/state/domain/index.d.ts",
      "default": "./lib/state/domain/index.js"
    },
    "./state/store": {
      "types": "./lib/types/state/store.d.ts",
      "default": "./lib/state/store.js"
    },
    "./state/migrate": {
      "types": "./lib/types/state/migrate.d.ts",
      "default": "./lib/state/migrate.js"
    },
    "./state/store-plugin": {
      "types": "./lib/types/state/store-plugin.d.ts",
      "default": "./lib/state/store-plugin.js"
    },
    "./state/v2-provider": {
      "types": "./lib/types/state/v2-provider.d.ts",
      "default": "./lib/state/v2-provider.js"
    }
  },
  "files": [
    "locale/runtime/*.json",
    "locale/*.json",
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "row-overrides.json",
    "persisted-write-inventory.json"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-evolution-platform": "workspace:^",
    "js-yaml": "^4.1.0",
    "yaml": "^2.4.2",
    "zod": "^4.4.3",
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^4.1.0"
  }
}
