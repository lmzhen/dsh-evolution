{
  "name": "@deepseek-ai/dsh-evolution-all",
  "description": "Full-functionality evolution bundle — DEFAULT install: host automation + model tools, all profile-root",
  "version": "0.7.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/evolution/evolution-all"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-evolution-host": "workspace:^",
    "@deepseek-ai/dsh-tool-memory": "workspace:^",
    "@deepseek-ai/dsh-tool-skill-manage": "workspace:^",
    "@deepseek-ai/dsh-tool-session-query": "workspace:^",
    "@deepseek-ai/dsh-evolution-skill-catalog": "workspace:^",
    "@deepseek-ai/dsh-evolution-agent-preset": "workspace:^",
    "@deepseek-ai/dsh-evolution-settings-ui": "workspace:^"
  }
}
