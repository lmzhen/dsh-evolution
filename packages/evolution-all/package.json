{
  "name": "@deepseek-ai/dsh-evolution-all",
  "description": "Full-functionality evolution bundle — DEFAULT install: host automation + model tools, all profile-root",
  "version": "0.45.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/evolution/evolution-all"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "resolverDependencies": [
      "@deepseek-ai/dsh-evolution-core"
    ]
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "docs/**/*.md"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-evolution-host": "workspace:^",
    "@deepseek-ai/dsh-tool-skill-manage": "workspace:^",
    "@deepseek-ai/dsh-evolution-agent-preset": "workspace:^",
    "@deepseek-ai/dsh-evolution-merge": "workspace:^",
    "@deepseek-ai/dsh-evolution-merge-ui": "workspace:^",
    "@deepseek-ai/dsh-evolution-core": "workspace:^",
    "@deepseek-ai/dsh-evolution-skill-discovery": "workspace:^",
    "@deepseek-ai/dsh-evolution-ui": "workspace:^",
    "@deepseek-ai/dsh-tool-session-query": "^0.2.2-rc.0",
    "@deepseek-ai/dsh-memory": "workspace:^",
    "@deepseek-ai/dsh-evolution-state": "workspace:^",
    "@deepseek-ai/dsh-evolution-approval": "workspace:^",
    "@deepseek-ai/dsh-evolution-activity": "workspace:^",
    "@deepseek-ai/dsh-evolution-review": "workspace:^",
    "@deepseek-ai/dsh-evolution-curator": "workspace:^",
    "@deepseek-ai/dsh-evolution-commands": "workspace:^",
    "@deepseek-ai/dsh-evolution-maintenance": "workspace:^",
    "@deepseek-ai/dsh-evolution-skill-health": "workspace:^"
  }
}
