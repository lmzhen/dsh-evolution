{
  "name": "@deepseek-ai/dsh-evolution-agent-preset",
  "description": "Agent preset exposing memory and skill evolution tools to a session",
  "version": "0.6.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/evolution/evolution-agent"
  },
  "type": "module",
  "files": [
    "agent.cordis.yml",
    "bases.json",
    "preset.yml",
    "preset.ptc.yml",
    "preset.cordis.yml",
    "preset.minimal.yml",
    "package.json",
    "lib/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-tool-memory": "workspace:^",
    "@deepseek-ai/dsh-tool-skill-manage": "workspace:^",
    "@deepseek-ai/dsh-tool-session-query": "workspace:^",
    "@deepseek-ai/dsh-evolution-skill-catalog": "workspace:^"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./agent.cordis.yml": "./agent.cordis.yml",
    "./bases.json": "./bases.json",
    "./preset.yml": "./preset.yml",
    "./preset.ptc.yml": "./preset.ptc.yml",
    "./preset.cordis.yml": "./preset.cordis.yml",
    "./preset.minimal.yml": "./preset.minimal.yml",
    "./package.json": "./package.json"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts"
}
