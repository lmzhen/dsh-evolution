{
  "name": "@deepseek-ai/dsh-evolution-merge",
  "description": "Skill auto-merge domain: screening, two-round authoring, queues and commit orchestration",
  "version": "0.61.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lmzhen/dsh-evolution.git",
    "directory": "packages/evolution-merge"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "dsh-evolution-merge-migrate": "scripts/merge-migrate.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "data/**/*",
    "scripts/merge-migrate.mjs",
    "scripts/merge-restore.mjs",
    "scripts/merge-backup.mjs",
    "scripts/engine-screen-worker.mjs",
    "package.json"
  ],
  "license": "MIT",
  "scripts": {
    "verify:publish-manifest": "node scripts/verify-publish-manifest.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-evolution-core": "workspace:^",
    "@deepseek-ai/dsh-evolution-commands": "workspace:^",
    "@deepseek-ai/dsh-evolution-merge-engine": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "@deepseek-ai/dsh-evolution-platform": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  }
}
