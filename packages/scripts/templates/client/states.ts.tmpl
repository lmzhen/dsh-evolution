import { createElement, type ReactNode } from 'react'
import type { RouteAnswer, RouteFailure } from './route-client.generated.ts'
import type { FallbackHint } from './contracts.generated.ts'

/**
 * The four-state base of every family card (W7 §2). Load states are read from the generated
 * route-client's answer — a card owns no HTTP vocabulary and no second state machine.
 */
export type LoadState<T> =
  | { readonly phase: 'loading' }
  | { readonly phase: 'ready'; readonly data: T }
  | { readonly phase: 'empty' }
  | { readonly phase: 'failed'; readonly failure: RouteFailure }

/** Map one classified answer onto the card's four states. */
export function loadStateOf<T>(answer: RouteAnswer<T>, isEmpty: (data: T) => boolean): LoadState<T> {
  if (!answer.ok) return { phase: 'failed', failure: answer.failure }
  return isEmpty(answer.data) ? { phase: 'empty' } : { phase: 'ready', data: answer.data }
}

/** The locale lookup every block calls (the platform's own `t`). */
export interface Translate {
  (key: string, values?: Readonly<Record<string, string | number>>): string
}

export type BlockTone = 'neutral' | 'warn' | 'fail'

export interface BlockProps {
  readonly tone?: BlockTone
  readonly title?: string
  readonly children?: ReactNode
}

/** A neutral/ warn/ fail block; a fail block is role=alert so assistive tech announces it. */
export function Block(props: BlockProps): ReactNode {
  const tone = props.tone ?? 'neutral'
  return createElement('div', { 'data-tone': tone, ...tone === 'fail' ? { role: 'alert' } : {} },
    props.title === undefined ? null : createElement('div', { 'data-tone-title': tone }, props.title),
    props.children,
  )
}

export interface FailureBlockProps {
  readonly failure: RouteFailure
  readonly t: Translate
  /** The command-face fallback for this surface (rendered on unmounted/failed answers). */
  readonly fallback?: FallbackHint | undefined
}

/** One classified failure as a reader-facing sentence. */
export function failureText(failure: RouteFailure, t: Translate): string {
  switch (failure.kind) {
    case 'unauthenticated': return t('failureUnauthorized')
    case 'forbidden': return t('failureForbidden')
    case 'unmounted': return t('failureUnmounted')
    case 'server': return failure.status === 0 ? t('failureServer') : t('failureServer') + ' (HTTP ' + String(failure.status) + ')'
    case 'refused': return failure.message
  }
}

/** The failed-state block: sentence + (when the surface exists but is unreachable) the command fallback. */
export function FailureBlock(props: FailureBlockProps): ReactNode {
  const hint = props.fallback === undefined
    ? null
    : createElement('div', { 'data-tone-hint': 'true' }, props.t('fallbackHint', { command: props.fallback.command }))
  return Block({ tone: 'fail', title: failureText(props.failure, props.t), children: hint })
}
