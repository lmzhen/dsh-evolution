        "prefix": "evolution",
        "exceptions": [
          {
            "key": "memory",
            "reason": "the key predates the prefix rule and family readers reach it through ctx.memory",
            "expiry": "group 6 (O-3): rename behind an alias window, or keep the registration"
          },
          {
            "key": "skillUsage",
            "reason": "same shape: a historical generic key with in-family readers",
            "expiry": "group 6 (O-3): rename behind an alias window, or keep the registration"
          }
        ]
      },
      "must": [
        {
          "text": "**every key is prefixed `evolution`**"
        },
        {
          "text": "`memory`"
        },
        {
          "text": "`skillUsage`"
        }
      ],
      "forbid": [],
      "cites": []
    },
    {
