    {
      "id": "gate-set",
      "title": "the gate's step set: what runs where, plus the two exception registers",
      "home": "repo:CONTRIBUTING.md",
      "machine": {
        "kind": "gate-set",
        "file": ".github/actions/evolution-validate/action.yml",
        "registers": {
          "localOnly": [
            {
              "script": "gen-install-counts.mjs",
              "reason": "the counts come from the mirror tree and README, which the overlay does not carry",
              "expiry": "release-phase wiring: add the step to the action or mark the row local-only"
            },
            {
              "script": "smoke-built-entries.mjs",
              "reason": "needs an installed platform scope; the local runner executes it, the publish job does not",
              "expiry": "release-phase wiring: add the step to the action or mark the row local-only"
            },
            {
              "script": "verify-mutations.mjs",
              "reason": "the mutation ledger is still being filled (3 of 68 checks have a proven record): --coverage is legitimately CANNOT DECIDE, so CI would read a cannot-decide as a failure; the records accrue per check as their retirements land",
              "expiry": "release gate: --coverage must reach exit 0 (every check carries a proven red record) before the tag, or this row is re-registered with the remaining count named"
            },
            {
              "script": "gen-health-baseline.mjs",
              "reason": "the health-baseline corpus is produced from the TARGET machine's user skills (the family maintains it per machine); the CI overlay carries no user skills, so a CI run would produce an empty corpus rather than the real one",
              "expiry": "release gate: the corpus is refreshed on the machine that owns it and its digest is recorded in the release readings; if a CI-side corpus is ever required, this row moves into the action"
            }
          ],
          "machineLocal": [
            {
              "script": "check-tsconfigs.cjs",
              "reason": "tsconfig registration for the overlay layout",
              "expiry": "S1.8 follow-up: port into packages/scripts"
            },
            {
              "script": "check-manifests.cjs",
              "reason": "manifest version uniformity across the two trees",
              "expiry": "S1.8 follow-up: port into packages/scripts"
            },
            {
              "script": "mirror-sync.mjs",
              "reason": "mirror <-> overlay parity check",
              "expiry": "S1.8 follow-up: port into packages/scripts"
            },
            {
              "script": "run-baseline.mjs",
              "reason": "the canonical local runner that executes this table",
              "expiry": "S1.8 follow-up: port into packages/scripts"
            }
          ]
        }
      },
      "must": [
        {
          "text": "| # | Command | Working tree |"
        },
        {
          "text": "all 50 steps",
          "unique": true
        }
      ],
      "forbid": [],
      "cites": []
