              "script": "gen-install-counts.mjs",
              "reason": "the counts come from the mirror tree and README, which the overlay does not carry",
              "expiry": "release-phase wiring: add the step to the action or mark the row local-only"
            },
            {
              "script": "smoke-built-entries.mjs",
              "reason": "needs an installed platform scope; the local runner executes it, the publish job does not",
              "expiry": "release-phase wiring: add the step to the action or mark the row local-only"
            },
            {
              "script": "verify-regression-set.mjs",
              "reason": "the merge-time regression set (guards + specs + audit self-checks); the publish job runs its own subset",
              "expiry": "release-phase wiring: decide whether the job adopts this runner"
            }
          ],
          "machineLocal": [
            {
              "script": "check-tsconfigs.cjs",
              "reason": "tsconfig registration for the overlay layout",
              "expiry": "S1.8 follow-up: port into packages/scripts"
            },
            {
              "script": "check-manifests.cjs",
              "reason": "manifest version uniformity across the two trees",
              "expiry": "S1.8 follow-up: port into packages/scripts"
            },
            {
              "script": "mirror-sync.mjs",
              "reason": "mirror <-> overlay parity check",
              "expiry": "S1.8 follow-up: port into packages/scripts"
            },
            {
              "script": "run-baseline.mjs",
              "reason": "the canonical local runner that executes this table",
              "expiry": "S1.8 follow-up: port into packages/scripts"
            }
          ]
        }
      },
      "must": [
        {
          "text": "| # | Command | Working tree |"
        },
        {
          "text": "all 46 steps",
          "unique": true
        }
      ],
      "forbid": [],
      "cites": []
