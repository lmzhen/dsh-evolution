        {
          "text": "the `@mode`",
          "unique": true
        }
      ],
      "forbid": [
        {
          "re": "There is no `evolution/",
          "why": "the family DOES emit process events (six of them); a document may not deny the set the emit sites re-derive"
        }
      ],
      "cites": []
    },
