    "@deepseek-ai/dsh-tools": "workspace:^",
    "@deepseek-ai/dsh-evolution-core": "workspace:^"
  },
  "dependencies": {
    "minisearch": "^7.2.0",
    "@deepseek-ai/schemastery": "workspace:^"
  }
